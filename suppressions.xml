<?xml version="1.0"?>

<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <suppress checks="MagicNumber"/>
    <suppress checks="AbbreviationAsWordInName"/>
    <suppress checks="ParameterNumber"/>
    <suppress checks="ReturnCount"/>
    <suppress checks="HiddenField"/>
    <suppress checks="MethodCount"/>
    <suppress checks="ClassFanOutComplexity"/>
    <suppress checks="ClassDataAbstractionCoupling"/>
    <suppress checks="ExecutableStatementCount"/>
    <suppress checks="JavaNCSS"/>
    <suppress checks="AnonInnerLength"/>
    <suppress checks="LambdaBodyLength"/>
    <suppress checks="AvoidEscapedUnicodeCharacters"/>
    <suppress checks="CyclomaticComplexity"/>
    <supress checks="NPathComplexity"/>
</suppressions>